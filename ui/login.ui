   <property name="styleSheet">
    <string notr="true">/* Nền xanh dương cực đậm huyền bí */
#centralwidget {
	background: #E3F2FD;
}

/* Các ô nhập dữ liệu nền xanh đêm, chữ trắng */
#o_email, #o_mat_khau {
	background: #131F42;
	border: 1px solid #1D2E61;
	border-radius: 10px;
	min-height: 40px;
	padding-left: 10px;
	color: #FFFFFF;
}
#o_email:focus, #o_mat_khau:focus {
	border: 1.5px solid #00B4D8; /* Lên viền xanh sáng của logo khi click chuột vào */
}

/* Các nhãn chữ đổi sang màu xanh sáng cho dễ đọc */
QLabel {
	color: #00B4D8;
}

/* Nút Register màu xanh Cyan nổi bần bật */
#nut_dang_nhap {
    border: 2px solid #000000;
    border-radius: 12px;
    background-color: rgba(0, 180, 216, 150);
    color: #0A1128;
    font-weight: bold;
    min-height: 40px;
}
#nut_dang_nhap:hover {
    border: 2px solid #1B5E20;
    background-color: rgba(0, 245, 212, 180);
}/* Di chuột vào sẽ sáng rực lên */


/* Chữ gợi ý và link Login */
#nhan_chua_co_tai_khoan {
	color: #E0E1DD;
}
#nut_chuyen_dang_ky {
	color: #00F5D4;
	background: transparent;
	border: none;
	outline: none;	
	text-align: left; 
}
#nut_chuyen_dang_ky:hover {
	color: #FFFFFF;
	text-decoration: underline;
}</string>
