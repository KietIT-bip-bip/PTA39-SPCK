   <property name="styleSheet">
    <string notr="true">/* Nền xanh dương cực đậm huyền bí */
#centralwidget {
	background: #0A1128;
}

/* Các ô nhập dữ liệu nền xanh đêm, chữ trắng */
#full_name, #email, #password, #password_2 {
	background: #131F42;
	border: 1px solid #1D2E61;
	border-radius: 10px;
	min-height: 40px;
	padding-left: 10px;
	color: #FFFFFF;
}
#full_name:focus, #email:focus, #password:focus, #password_2:focus {
	border: 1.5px solid #00B4D8; /* Lên viền xanh sáng của logo khi click chuột vào */
}

/* Các nhãn chữ đổi sang màu xanh sáng cho dễ đọc */
QLabel {
	color: #00B4D8;
}

/* Nút Register màu xanh Cyan nổi bần bật */
#signup {
	background: #00B4D8;
	color: #0A1128;
	font-weight: bold;
	border: none;
	outline: none;
	border-radius: 10px;
	min-height: 40px;
}
#signup:hover {
	background: #00F5D4; /* Di chuột vào sẽ sáng rực lên */
}

/* Chữ gợi ý và link Login */
#label_5 {
	color: #E0E1DD;
}
#nav_login {
	color: #00F5D4;
	background: transparent;
	border: none;
	outline: none;	
	text-align: left; 
}
#nav_login:hover {
	color: #FFFFFF;
	text-decoration: underline;
}</string>
